bindings <- action
          / { num raction, 'repeat-fn $1 { $2 }' }

action <- { 'Z' 'Z', 'save; quit' }
        / { 'i',  'set-mode vim-insert' }
        / { 'a',  'move-to [right [cursor-pos]]; set-mode vim-insert' }
        / { 'v',  'set-mode vim-visual; select-to [right [cursor-pos]]' }
        / { 'X', 'remove-to [left [cursor-pos]]'}
        / { 'x', 'remove-to [right [cursor-pos]]'}
        / { 's', 'remove-to [left [cursor-pos]]; set-mode vim-insert'}
        / { 'S', 'remove-range [line-start [cursor-pos]] [line-end [cursor-pos]]; set-mode vim-insert'}
        / { 'u', 'undo'}
        / { 'ctrl+r', 'redo'}
        / { 'ctrl+l', 'refresh'}
        / { 'o',  'move-to [line-end [cursor-pos]]; insert \\n; set-mode vim-insert' }
        / { 'O',  'move-to [line-start [cursor-pos]]; insert \\n; move-to [up [cursor-pos]]; set-mode vim-insert' }
        / { ':',  'command' }

raction <- { move       , 'move-to [$1]' }
         / { 'd' 'd', 'remove-range [line-start [cursor-pos]] [next-line-start [cursor-pos]]' }
         / { 'd' deletemove, 'remove-to [$1]' }
         / { 'c' deletemove, 'remove-to [$1]; set-mode vim-insert' }

deletemove <- { 'e'       , 'expr { [word-end [cursor-pos]] + 1 }' }
            / { 'E'       , 'expr { [ws-end [cursor-pos]] + 1 }' }
            / { move, '$1'}

move <- { 'w'       , 'word-right [cursor-pos]' }
      / { 'W'       , 'ws-right [cursor-pos]' }
      / { 'b'       , 'word-left [cursor-pos]' }
      / { 'B'       , 'ws-left [cursor-pos]' }
      / { 'e'       , 'word-end [cursor-pos]' }
      / { 'E'       , 'ws-end [cursor-pos]' }
      / { 'f' any   , 'find-char $1 [cursor-pos]' }
      / { 'F' any   , 'find-char-back $1 [cursor-pos]' }
      / { 'h'       , 'left [cursor-pos]' }
      / { 'j'       , 'down [cursor-pos]' }
      / { 'k'       , 'up [cursor-pos]' }
      / { 'l'       , 'right [cursor-pos]' }
      / { '$'       , 'line-end [cursor-pos]' }
      / { '^'       , 'line-start [cursor-pos]' }
      / { '0'       , 'line-start [cursor-pos]' }
      / { 'g' 'g'          , 'zero' }
      / { 'G'           , 'size' }
      / { '/'           , 'find-prompt' }

num <- { [0-9]* , '$0' }
any <- { .      , '$0' }
