bindings <- {'ctrl+s', 'save'}
          / {'ctrl+q', 'quit'}
          / {'ctrl+z', 'undo'}
          / {'ctrl+e', 'command'}
          / {'ctrl+b', 'shell'}
          / {'ctrl+y', 'redo'}
          / {'ctrl+v', 'paste'}
          / {'ctrl+l', 'refresh'}
          / {'ctrl+w', 'split-select-next'}
          / {'ctrl+g' ('ctrl+w' / 'w'), 'split-select-next'}
          / {'ctrl+g' '/', 'vsplit'}
          / {'ctrl+g' '-', 'hsplit'}
          / {'ctrl+g' 't', 'term'}
          / {'ctrl+t', 'tab'}
          / {'ctrl+f', 'find-prompt'}
          / {'ctrl+o', 'command-edit "open "'}
          / {'mouseleft', 'move-to [mouse-loc $1]'}
          / {'paste', 'insert-at [cursor-pos] $0; relocate'}
          / {'tab',    'insert-at [cursor-pos] \\t; relocate'}
          / {'enter', 'insert-at [cursor-pos] \\n; relocate'}
          / {'backspace', 'set char [left [cursor-pos]]; remove $char [cursor-pos]; relocate'}
          / {'delete', 'set char [right [cursor-pos]]; remove [cursor-pos] $char'}
          / {., 'insert-at [cursor-pos] $0; relocate'}
          / {move, 'move-to [$1]'}
          / {select, 'select-to [$1]'}

move <- {'left', 'left [cursor-pos]'}
      / {'right', 'right [cursor-pos]'}
      / {'up', 'up [cursor-pos]'}
      / {'down', 'down [cursor-pos]'}
      / {'ctrl+down', 'size'}
      / {'ctrl+up', 'zero'}
      / {'ctrl+left', 'word-left [cursor-pos]'}
      / {'ctrl+right', 'word-right [cursor-pos]'}
      / {'alt+right', 'ws-right [cursor-pos]'}
      / {'alt+left', 'ws-left [cursor-pos]'}

select <- {'shift+left', 'left [cursor-pos]'}
      / {'shift+right', 'right [cursor-pos]'}
      / {'shift+up', 'up [cursor-pos]'}
      / {'shift+down', 'down [cursor-pos]'}
