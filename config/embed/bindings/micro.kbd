bindings <- {'ctrl+s', 'save'}
          / {'ctrl+q', 'quit'}
          / {'ctrl+z', 'undo'}
          / {'ctrl+e', 'command'}
          / {'ctrl+b', 'shell'}
          / {'ctrl+y', 'redo'}
          / {'ctrl+v', 'paste'}
          / {'ctrl+l', 'refresh'}
          / {'ctrl+w', 'split-select-next'}
          / {'ctrl+g' ('ctrl+w' / 'w'), 'split-select-next'}
          / {'ctrl+g' '/', 'vsplit'}
          / {'ctrl+g' '-', 'hsplit'}
          / {'ctrl+g' 't', 'term'}
          / {'ctrl+t', 'tab'}
          / {'ctrl+f', 'find-prompt'}
          / {'ctrl+n', 'find-next'}
          / {'ctrl+p', 'find-prev'}
          / {'ctrl+o', 'command-edit "open "'}
          / {'mouseleft', 'mouse-click $0'}
          / {'mousenone', 'mouse-release $0'}
          / {'ctrl+mouseleft', 'spawn-cursor [visual-pos $0]'}
          / {'alt+c', 'remove-cursors'}
          / {'mousewheelup', 'scroll-up 2'}
          / {'mousewheeldown', 'scroll-down 2'}
          / {'paste', 'all-cursors { insert $0 }'}
          / {'tab',    'all-cursors { insert \\t }'}
          / {'enter', 'all-cursors { insert \\n }'}
          / {'backspace', 'all-cursors { if { [cursor-has-selection] } { remove-selection } else { remove-to [left [cursor-pos]] } }'}
          / {'delete', 'all-cursors { if { [cursor-has-selection] } { remove-selection } else { remove-to [right [cursor-pos]] } }'}
          / {., 'all-cursors { insert $0 }'}
          / {move, 'all-cursors { move-to [$1] }'}
          / {select, 'all-cursors { select-to [$1] }'}

move <- {'left', 'left [cursor-pos]'}
      / {'right', 'right [cursor-pos]'}
      / {'up', 'up [cursor-pos]'}
      / {'down', 'down [cursor-pos]'}
      / {'ctrl+down', 'size'}
      / {'ctrl+up', 'zero'}
      / {'ctrl+left', 'word-left [cursor-pos]'}
      / {'ctrl+right', 'word-right [cursor-pos]'}
      / {'alt+right', 'ws-right [cursor-pos]'}
      / {'alt+left', 'ws-left [cursor-pos]'}

select <- {'shift+left', 'left [cursor-pos]'}
        / {'shift+right', 'right [cursor-pos]'}
        / {'shift+up', 'up [cursor-pos]'}
        / {'shift+down', 'down [cursor-pos]'}
        / {'shift+ctrl+down', 'size'}
        / {'shift+ctrl+up', 'zero'}
        / {'shift+ctrl+left', 'word-left [cursor-pos]'}
        / {'shift+ctrl+right', 'word-right [cursor-pos]'}
        / {'shift+alt+right', 'ws-right [cursor-pos]'}
        / {'shift+alt+left', 'ws-left [cursor-pos]'}
