bindings <- {'ctrl+s', 'save'}
          / {'ctrl+q', 'quit'}
          / {'ctrl+z', 'undo'}
          / {'ctrl+e', 'command'}
          / {'ctrl+b', 'shell'}
          / {'ctrl+y', 'redo'}
          / {'ctrl+v', 'paste'}
          / {'ctrl+l', 'refresh'}
          / {'ctrl+w', 'split-select-next'}
          / {'ctrl+g' ('ctrl+w' / 'w'), 'split-select-next'}
          / {'ctrl+g' '/', 'vsplit'}
          / {'ctrl+g' '-', 'hsplit'}
          / {'ctrl+g' 't', 'term'}
          / {'ctrl+t', 'tab'}
          / {'ctrl+f', 'find-prompt'}
          / {'ctrl+o', 'command-edit "open "'}
          / {'mouseleft', 'move-to [visual-pos $0]'}
          / {'mousewheelup', 'scroll-up 2'}
          / {'mousewheeldown', 'scroll-down 2'}
          / {'paste', 'insert $0'}
          / {'tab',    'insert \\t'}
          / {'enter', 'insert \\n'}
          / {'backspace', 'if { [cursor-has-selection] } { remove-selection } else { remove-to [left [cursor-pos]] }'}
          / {'delete', 'if { [cursor-has-selection] } { remove-selection } else { remove-to [right [cursor-pos]] }'}
          / {., 'insert $0'}
          / {move, 'move-to [$1]'}
          / {select, 'select-to [$1]'}

move <- {'left', 'left [cursor-pos]'}
      / {'right', 'right [cursor-pos]'}
      / {'up', 'up [cursor-pos]'}
      / {'down', 'down [cursor-pos]'}
      / {'ctrl+down', 'size'}
      / {'ctrl+up', 'zero'}
      / {'ctrl+left', 'word-left [cursor-pos]'}
      / {'ctrl+right', 'word-right [cursor-pos]'}
      / {'alt+right', 'ws-right [cursor-pos]'}
      / {'alt+left', 'ws-left [cursor-pos]'}

select <- {'shift+left', 'left [cursor-pos]'}
        / {'shift+right', 'right [cursor-pos]'}
        / {'shift+up', 'up [cursor-pos]'}
        / {'shift+down', 'down [cursor-pos]'}
        / {'shift+ctrl+down', 'size'}
        / {'shift+ctrl+up', 'zero'}
        / {'shift+ctrl+left', 'word-left [cursor-pos]'}
        / {'shift+ctrl+right', 'word-right [cursor-pos]'}
        / {'shift+alt+right', 'ws-right [cursor-pos]'}
        / {'shift+alt+left', 'ws-left [cursor-pos]'}
